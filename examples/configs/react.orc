react Light turns on set off --delay=15
react Sensor.LIVING_ROOM temperature between 68 and 75 set AC cool:low:72
react Sensor.LIVING_ROOM dewpoint(temperature,humidity) between 50 and 60 present alice,bob set AC fan_only:low:70
react Sensor.ENTRANCE_SENSOR turns active set Light      on
react Sensor.ENTRANCE_SENSOR turns active set Chromecast pause
