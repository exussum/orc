setting foo_backend     orc_plugins.example.dal.foo.acme
setting bar_backend     orc_plugins.example.dal.bar.globex
setting cron            '0 6 * * *'
setting window_hours    6
setting foo_secret      FOO_KEY
setting bar_secret      BAR_KEY
setting http_timeout    120

widget Alpha 10
widget Beta  20

zone north Home   '123 Main St, Springfield'
zone north Office '500 Market St, Metropolis'
zone south Villa  '9 Beach Rd, Seaside'
