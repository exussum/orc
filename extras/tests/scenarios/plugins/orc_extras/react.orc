react Sensor.ENTRANCE_SENSOR turns active   set AC cool:low:75
react Sensor.ENTRANCE_SENSOR turns active   set Light.LIVING_ROOM on
react Sensor.ENTRANCE_SENSOR turns inactive set AC off

react Light.BEDROOM_LAMP turns on set Chromecast pause
react Light.BEDROOM_LAMP turns on set Light.LIVING_ROOM on
react Light.BEDROOM_LAMP turns on set Light.KITCHEN on
react Light.BEDROOM_LAMP turns on set Light.HALL on
react Light.BEDROOM_LAMP turns on set Light.PORCH off
react Light.BEDROOM_LAMP turns on set Light.OFFICE off
react Light.BEDROOM_LAMP turns on set Light.OFFICE on
